---
layout: default
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ page.type }}
      {% if page.semester %}• {{ page.semester }}{% endif %}
      {% if page.venue %}• {{ page.venue }}{% endif %}
    </p>
    {% if page.website %}
    <p>
      <a href="{{ page.website }}" class="btn btn-primary" target="_blank">
        <i class="fas fa-globe"></i> Course Website
      </a>
    </p>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content }}
  </div>

  <footer class="post-footer">
    {% if page.category %}
    <div class="post-category">
      <strong>Category:</strong> {{ page.category }}
    </div>
    {% endif %}
    
    {% if page.prerequisites %}
    <div class="prerequisites">
      <h3>Prerequisites</h3>
      <ul>
        {% for item in page.prerequisites %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    
    {% if page.github %}
    <div class="github-link">
      <a href="{{ page.github }}" class="btn btn-github" target="_blank">
        <i class="fab fa-github"></i> View on GitHub
      </a>
    </div>
    {% endif %}
  </footer>
</article>
