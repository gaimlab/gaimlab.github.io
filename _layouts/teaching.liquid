---
layout: default
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      {{ page.type }}
      {% if page.semester %}• {{ page.semester }}{% endif %}
      {% if page.venue %}• {{ page.venue }}{% endif %}
    </p>
    {% if page.website %}
    <p>
      <a href="{{ page.website }}" class="btn btn-primary" target="_blank">
        <i class="fas fa-globe"></i> Course Website
      </a>
    </p>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content }}
  </div>
  
</article>
